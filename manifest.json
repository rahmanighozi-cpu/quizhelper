{
  "manifest_version": 3,
  "name": "Quiz AI Helper Fast",
  "version": "1.3",
  "description": "AI Quiz Solver Fast Response dengan Tema White Minimalist & Shortcut Hide Total",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Quiz AI Helper"
  },
  "commands": {
    "toggle-popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Sembunyikan Total atau Munculkan Pop-up Quiz AI"
    }
  }
}
